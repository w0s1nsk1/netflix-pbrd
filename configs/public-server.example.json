{
  "role": "controller",
  "interval": "15s",
  "reapply_interval": "5m",
  "state_file": "/var/lib/netflix-pbrd/networks.state",
  "api": {
    "listen": ":18443",
    "token": "REPLACE_WITH_A_LONG_RANDOM_TOKEN",
    "report_token": "REPLACE_WITH_A_DIFFERENT_LONG_REPORT_TOKEN",
    "tls_cert": "/etc/letsencrypt/live/vpn.example.com/fullchain.pem",
    "tls_key": "/etc/letsencrypt/live/vpn.example.com/privkey.pem"
  },
  "apply": [{
    "driver": "linux-exit",
    "source_net": "10.66.0.0/24",
    "wan_interface": "eth0",
    "chain": "NETFLIX_EXIT"
  }]
}
