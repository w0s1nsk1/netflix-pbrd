{
  "role": "controller",
  "interval": "15s",
  "state_file": "/var/lib/netflix-pbrd/networks.state",
  "api": {
    "listen": ":18443",
    "token": "REPLACE_WITH_A_LONG_RANDOM_TOKEN",
    "tls_cert": "/etc/letsencrypt/live/vpn.example.com/fullchain.pem",
    "tls_key": "/etc/letsencrypt/live/vpn.example.com/privkey.pem"
  },
  "discovery": {
    "dns_server": "1.1.1.1:53",
    "domains": ["api-global.netflix.com", "nrdp52-appboot.netflix.com", "cast.netflix.com", "android14-tman.prod.cloud.netflix.com", "android.prod.cloud.netflix.com"]
  },
  "apply": [{
    "driver": "linux-exit",
    "source_net": "10.66.0.0/24",
    "wan_interface": "eth0",
    "chain": "NETFLIX_EXIT"
  }]
}
