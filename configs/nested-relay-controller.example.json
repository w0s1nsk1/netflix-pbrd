{
  "role": "controller",
  "interval": "15s",
  "state_file": "/root/netflix-pbrd/networks.state",
  "api": {
    "listen": "172.31.255.1:18080",
    "token": "REPLACE_WITH_A_LONG_RANDOM_TOKEN",
    "report_token": "REPLACE_WITH_A_DIFFERENT_LONG_REPORT_TOKEN",
    "allow_insecure_http": true
  },
  "apply": [{
    "driver": "linux-exit",
    "source_net": "192.168.8.0/24",
    "wan_interface": "wan",
    "chain": "NETFLIX_EXIT"
  }]
}
