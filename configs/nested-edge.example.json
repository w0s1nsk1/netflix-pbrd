{
  "role": "agent",
  "interval": "15s",
  "state_file": "/opt/var/lib/netflix-pbrd/networks.state",
  "api": {
    "source_url": "http://172.31.255.1:18080/v1/networks",
    "token": "REPLACE_WITH_A_LONG_RANDOM_TOKEN",
    "report_token": "REPLACE_WITH_A_DIFFERENT_LONG_REPORT_TOKEN",
    "allow_insecure_http": true
  },
  "dns_proxy": {
    "listen": "192.168.8.2:1053",
    "upstream": "10.8.0.1:53"
  },
  "apply": [{
    "driver": "linux-edge",
    "interface": "wg-relay",
    "peer": "RELAY_WIREGUARD_PUBLIC_KEY",
    "base_allowed": ["0.0.0.0/0"],
    "source_net": "192.168.8.0/24",
    "input_interface": "br+",
    "table": "202",
    "rule_priority": "12020",
    "mark": "0x20000000",
    "mask": "0xff000000",
    "chain": "NETFLIX_PBR"
  }]
}
