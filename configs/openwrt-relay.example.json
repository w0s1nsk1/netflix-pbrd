{
  "role": "agent",
  "interval": "15s",
  "state_file": "/root/netflix-pbrd/networks.state",
  "api": {
    "source_url": "http://10.8.0.1:18080/v1/networks",
    "token": "REPLACE_WITH_A_LONG_RANDOM_TOKEN",
    "report_token": "REPLACE_WITH_A_DIFFERENT_LONG_REPORT_TOKEN",
    "allow_insecure_http": true
  },
  "apply": [{
    "driver": "openwrt-pbr",
    "pbr_section": "@policy[4]",
    "firewall_section": "@rule[13]"
  }]
}
