#!/bin/sh

PATH=/opt/sbin:/opt/bin:/system/bin:/system/xbin:/sbin:/bin
CONFIG=${NETFLIX_PBR_RELAY_CONFIG:-/opt/etc/netflix-pbr-relay.conf}
[ -r "$CONFIG" ] || exit 1
. "$CONFIG"

: "${RELAY_INTERFACE:?RELAY_INTERFACE is required}"
EDGE_TABLE=${EDGE_TABLE:-202}

if [ -n "$DNS_REDIRECT_SERVICE" ] && [ -x "$DNS_REDIRECT_SERVICE" ]; then
	"$DNS_REDIRECT_SERVICE" start || exit 1
fi

if ! ip link show "$RELAY_INTERFACE" >/dev/null 2>&1; then
	/opt/etc/init.d/S47wg-relay start || exit 1
fi

if ! /opt/bin/busybox pidof netflix-pbrd >/dev/null 2>&1; then
	/opt/etc/init.d/S48netflix-pbrd start
elif ! ip route show table "$EDGE_TABLE" | grep -q "^default .* dev $RELAY_INTERFACE"; then
	for pid in $(/opt/bin/busybox pidof netflix-pbrd); do
		kill "$pid"
	done
	sleep 1
	/opt/etc/init.d/S48netflix-pbrd start
fi
