#!/bin/sh

CONFIG=${NETFLIX_PBR_RELAY_CONFIG:-/opt/etc/netflix-pbr-relay.conf}
[ -r "$CONFIG" ] || { echo "missing $CONFIG" >&2; exit 1; }
. "$CONFIG"

WG=${WG:-/opt/bin/wg}
: "${RELAY_INTERFACE:?RELAY_INTERFACE is required}"
: "${RELAY_KEY_FILE:?RELAY_KEY_FILE is required}"
: "${RELAY_PEER_PUBLIC_KEY:?RELAY_PEER_PUBLIC_KEY is required}"
: "${RELAY_ENDPOINT:?RELAY_ENDPOINT is required}"
: "${RELAY_ADDRESS:?RELAY_ADDRESS is required}"
: "${RELAY_ALLOWED_IPS:?RELAY_ALLOWED_IPS is required}"
RELAY_MTU=${RELAY_MTU:-1340}
RELAY_KEEPALIVE=${RELAY_KEEPALIVE:-25}

add_input_rule() {
	[ -n "$INPUT_CHAIN" ] && [ -n "$INPUT_PEER_SOURCE" ] || return 0
	iptables -C "$INPUT_CHAIN" -i "$RELAY_INTERFACE" -s "$INPUT_PEER_SOURCE" -j ACCEPT 2>/dev/null || \
		iptables -I "$INPUT_CHAIN" 1 -i "$RELAY_INTERFACE" -s "$INPUT_PEER_SOURCE" -j ACCEPT
}

del_input_rule() {
	[ -n "$INPUT_CHAIN" ] && [ -n "$INPUT_PEER_SOURCE" ] || return 0
	while iptables -C "$INPUT_CHAIN" -i "$RELAY_INTERFACE" -s "$INPUT_PEER_SOURCE" -j ACCEPT 2>/dev/null; do
		iptables -D "$INPUT_CHAIN" -i "$RELAY_INTERFACE" -s "$INPUT_PEER_SOURCE" -j ACCEPT
	done
}

start() {
	ip link show "$RELAY_INTERFACE" >/dev/null 2>&1 || ip link add "$RELAY_INTERFACE" type wireguard
	ip address replace "$RELAY_ADDRESS" dev "$RELAY_INTERFACE"
	"$WG" set "$RELAY_INTERFACE" private-key "$RELAY_KEY_FILE" peer "$RELAY_PEER_PUBLIC_KEY" \
		endpoint "$RELAY_ENDPOINT" allowed-ips "$RELAY_ALLOWED_IPS" persistent-keepalive "$RELAY_KEEPALIVE"
	ip link set mtu "$RELAY_MTU" dev "$RELAY_INTERFACE"
	ip link set up dev "$RELAY_INTERFACE"
	add_input_rule
}

stop() {
	del_input_rule
	ip link del "$RELAY_INTERFACE" >/dev/null 2>&1 || true
}

case "$1" in
	start)
		start
		;;
	restart|reconfigure)
		stop
		start
		;;
	stop|kill)
		stop
		;;
esac
